# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin dashboard — set both in .env.local AND Vercel environment variables
# VITE_ADMIN_PATH: a long, random URL segment (e.g. narsha-internal-a7x3k9)
# VITE_ADMIN_PASSWORD: password shown on the gate screen
VITE_ADMIN_PATH=your_secret_admin_path
VITE_ADMIN_PASSWORD=your_admin_password

# 「나의 한국어 책상」 — Edge Function 엔드포인트 베이스 (선택)
# 미설정 시 VITE_SUPABASE_URL + "/functions/v1" 로 자동 파생된다.
# 예: https://xxxx.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=
