# NARSHA 클라이언트 환경변수
#
# 이 파일을 `.env.local` 로 복사해서 값을 채운다. `.env.local` 은 gitignore 된다.
# Vercel 에 배포할 때는 같은 값을 프로젝트 Environment Variables 에도 넣어야 한다.
#
# ⚠️ `VITE_` 프리픽스가 붙은 값은 **클라이언트 번들에 그대로 인라인된다.**
#    서버에서만 알아야 하는 값(service role key, SMTP 비밀번호, Edge Function 시크릿)은
#    절대 여기에 두지 말고 Supabase 대시보드 / Vercel 서버 환경변수에 둔다.

# ── Supabase ──────────────────────────────────────────────────────────────────
# 대시보드 → Project Settings → API 에서 확인한다.
# anon key 는 공개되어도 되는 값이다 (RLS 로 접근을 통제한다).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── 운영자 대시보드 경로 ──────────────────────────────────────────────────────
# 라우트 경로 한 조각일 뿐이다. 길고 임의의 문자열을 쓰지만 **인증 수단이 아니다** —
# 실제 권한 판정은 Supabase Auth 세션 + `profiles.role`(화면) 과 RLS·Edge Function(서버)
# 에서 한다. 값이 없으면 `admin` 으로 동작한다.
#
# ⚠️ 예전에 있던 `VITE_ADMIN_PASSWORD` 는 제거됐다. 번들에 인라인되어 노출되기 때문이다
#    (GNB PRD REQ-H). 다시 추가하지 말 것.
VITE_ADMIN_PATH=your_secret_admin_path

# ── 「나의 한국어 책상」 Edge Function 엔드포인트 (선택) ───────────────────────
# 비워 두면 VITE_SUPABASE_URL + "/functions/v1" 로 자동 파생된다.
# 예: https://your-project-ref.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=
